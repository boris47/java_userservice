{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "rootDir": "./",
    "outDir": "dist",
    "baseUrl": "./",
    "paths": {
      "@shared/*": [
        "./shared/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "hooks/*.ts",
    "shared/**/*.ts"
, "hooks/after-pack.js"  ],
  "exclude": [
    "node_modules",
    "angular-app"
  ],
}